   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv('base/vendas.csv', delimiter=';')\n",
    "\n",
    "df['margem'] = round(df.lucro_bruto / df.receita,2)\n",
    "df['data'] = pd.to_datetime(df['data'], format=\"%d/%m/%Y\")\n",
    "\n",
    "df.head()"
   ]
